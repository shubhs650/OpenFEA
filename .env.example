# Optional shell configuration; scripts do not automatically load .env files.
# Use synthetic fixtures only. No AWS or Google credentials are needed.
FEA_ENV=local
FEA_AUTH_MODE=local
FEA_BIND_HOST=127.0.0.1
FEA_API_PORT=8000
FEA_WEB_PORT=5173
# Absolute writable location outside the checkout; default is /tmp/openfea-data.
FEA_DATA_ROOT=/tmp/openfea-data
# T002 will provision and verify the native solver. No fallback is implemented.
# FEA_CCX_PATH=/absolute/path/to/verified/ccx
